{
  "name": "usf-baseball-goat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:ui": "node scripts/interface-audit.mjs --tabs /player/824443 && node scripts/interface-audit.mjs /pitchers /hitters /tunneling /arsenal /arsenal/FF /glossary /reports /login /register",
    "audit:paint": "node scripts/interface-paint.mjs /hitters /pitchers /tunneling /arsenal /arsenal/FF /glossary /reports /login /register \"/player/824443#Overview\" \"/player/1000468924#Overview\"",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "create-user": "tsx ../scripts/create-user.ts",
    "fall:bake": "USE_LOCAL_DATA=true nice -n 10 tsx scripts/bake-fall.ts",
    "fall:blast-plus": "cd ../.. && nice -n 10 Rscript Swing+/fall_blast_plus.R",
    "fall:wcc-ref": "cd .. && python3 scripts/bake_fall_wcc_ref.py",
    "fall:all": "npm run fall:bake && npm run fall:blast-plus",
    "fall:compact": "nice -n 10 tsx scripts/compact-blast.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "@libsql/client": "^0.14.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/heatmap": "^0.99.0",
    "@nivo/scatterplot": "^0.99.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.60.5",
    "@tanstack/react-table": "^8.20.5",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "border-beam": "^1.3.0",
    "drizzle-orm": "^0.36.4",
    "html-to-image": "1.11.13",
    "nanoid": "^5.0.9",
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "thinking-orbs": "^0.1.1",
    "three": "^0.185.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^0.453.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
